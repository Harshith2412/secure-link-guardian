# SecureLink Guardian - Environment Configuration
# Copy this file to .env and update with your values

# Application
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_SCAN=20 per minute

# Redis (optional - for caching)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB (optional - for analytics)
MONGODB_ENABLED=False
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=securelink_guardian
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Cache Settings (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# Detection Features
ENABLE_DNS_ANALYSIS=True
ENABLE_URL_ANALYSIS=True
ENABLE_WEB_ANALYSIS=True
ENABLE_ML_ANALYSIS=True
ENABLE_GENETIC_ANALYSIS=True

# Sandbox Settings
SANDBOX_TIMEOUT=30
SANDBOX_MAX_REDIRECTS=5

# Risk Scoring Weights (must sum to 1.0)
WEIGHT_DNS=0.3
WEIGHT_URL=0.25
WEIGHT_WEB=0.3
WEIGHT_ML=0.15

# Risk Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=70

# Domain Age Thresholds (days)
DOMAIN_AGE_SUSPICIOUS=30
DOMAIN_AGE_NEW=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/securelink.log
